# Template for `.env` (git-ignored; the dev server refuses to serve dotfiles).
# Don't fill this in by hand. Run:
#     python tools/init_admin.py --email admin@Evpedia.com
# which asks for the password and writes the two lines below, storing only a
# PBKDF2 hash of the password (never the password itself).
# TEMPORARY DEVELOPMENT CREDENTIALS: replaced by the Phase 11 backend.
ADMIN_EMAIL=admin@evpedia.com
ADMIN_PASSWORD_HASH=pbkdf2_sha256$600000$<salt>$<hash>
