# Template for `.env` (git-ignored; the dev server refuses to serve dotfiles).
# Copy to `.env` and fill in. Never commit real values.

# The admin account's email. Set it (and the admin password) with:
#     python tools/init_admin.py --email k.soham.025@gmail.com
# which stores only a scrypt hash of the password in .data/accounts.json.
ADMIN_EMAIL=k.soham.025@gmail.com

# Password-reset emails (https://resend.com). Without a key, Forgot password
# says that email isn't set up; it never pretends to send.
RESEND_API_KEY=your_resend_api_key
# Sender. Must be on a domain you verified in Resend. Without a verified
# domain, leave this out: the default "EVENTORA <onboarding@resend.dev>" can
# only deliver to the email address that owns your Resend account.
EMAIL_FROM=EVENTORA <noreply@your-verified-domain.com>

# Optional: "off" stops importing accounts from the old browser-only prototype.
# LEGACY_IMPORT=off
