# Template for `.env`. Copy it to `.env` and fill in the values there.
# `.env` is git-ignored and never served; this file holds placeholders only.

# The admin account's email (then run: python tools/init_admin.py --email <it>).
ADMIN_EMAIL=

# Resend API key (https://resend.com -> API Keys). Server-side only.
RESEND_API_KEY=

# Sender, e.g. EVENTORA <noreply@your-verified-domain.com>, on a domain you
# verified in Resend. Leave empty to use EVENTORA <onboarding@resend.dev>,
# which only delivers to the email address that owns your Resend account.
EMAIL_FROM=
